XXXCLAW_MODEL_PROVIDER=openai
XXXCLAW_MODEL_NAME=kimi-k2.6
OPENAI_API_KEY=
MOONSHOT_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
XXXCLAW_WORKSPACE_ROOT_DIR=../xxxclaw-workspace
XXXCLAW_WORKSPACE_ROOT_HOST=../xxxclaw-workspace
XXXCLAW_MAX_TOOL_ROUNDS=6
XXXCLAW_SHELL_TIMEOUT_SECONDS=30
XXXCLAW_SHELL_EXECUTION_MODE=docker
XXXCLAW_SHELL_SANDBOX_IMAGE=xxxclaw-sandbox:latest
XXXCLAW_SHELL_DOCKER_BINARY=docker
XXXCLAW_SHELL_DOCKER_NETWORK=
XXXCLAW_SHELL_DOCKER_MEMORY=512m
XXXCLAW_SHELL_DOCKER_CPUS=1
XXXCLAW_LLM_TIMEOUT_SECONDS=180
XXXCLAW_LLM_MAX_RETRIES=1
XXXCLAW_CONTEXT_MAX_TOKENS=32000
XXXCLAW_CONTEXT_RECENT_TOKENS=20000
XXXCLAW_CONTEXT_OLDER_MEMORY_TOKENS=5000
XXXCLAW_PROJECT_MEMORY_FILE=XAGENTS.md
XXXCLAW_PROJECT_MEMORY_MAX_CHARS=4000
XXXCLAW_TOOL_RESULT_MAX_CHARS=4000
XXXCLAW_TOOL_RESULT_SINGLE_MAX_CHARS=50000
XXXCLAW_TOOL_RESULT_TURN_BUDGET_CHARS=200000
XXXCLAW_ASSISTANT_REASONING_MAX_CHARS=2000
XXXCLAW_SKILL_HISTORY_WINDOW_MESSAGES=8
XXXCLAW_FEATURE_RUNTIME_CONTEXT=1
XXXCLAW_FEATURE_OLDER_MEMORY=1
XXXCLAW_FEATURE_RECOVERY=1
XXXCLAW_FEATURE_WORKSPACE_ISOLATION=1
XXXCLAW_FEISHU_APP_ID=
XXXCLAW_FEISHU_APP_SECRET=
# Optional in long connection mode; used by webhook mode.
XXXCLAW_FEISHU_VERIFICATION_TOKEN=
XXXCLAW_FEISHU_BOT_OPEN_ID=
XXXCLAW_FEISHU_BASE_URL=https://open.feishu.cn/open-apis/
# Webhook-only settings. Long connection mode does not use them.
XXXCLAW_FEISHU_HOST=0.0.0.0
XXXCLAW_FEISHU_PORT=8000
XXXCLAW_FEISHU_WEBHOOK_PATH=/feishu/webhook
XXXCLAW_FEISHU_TIMEOUT_SECONDS=15
XXXCLAW_FEISHU_REPLY_MAX_CHARS=4000
XXXCLAW_FEISHU_WORKER_COUNT=2
XXXCLAW_FEISHU_LOG_LEVEL=INFO
XXXCLAW_FEISHU_GROUP_SESSION_SCOPE=chat_user
XXXCLAW_FEISHU_CONSOLE_STREAM=1
XXXCLAW_FEISHU_SHOW_TOOL_STATUS=0
